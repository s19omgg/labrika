# Server process environment only (no VITE_ prefix).
# Example: CREATIVE_GATEWAY_URL=https://adapter.example/api npm run dev -- --port 3000
CREATIVE_GATEWAY_URL=
CREATIVE_GATEWAY_KEY=
# Optional; otherwise generated privately in .data/approval-issuer.key
APPROVAL_ISSUER_KEY=

# LABRICA transactional email (server only).
POSTBOX_SMTP_HOST=postbox.cloud.yandex.net
POSTBOX_SMTP_PORT=587
POSTBOX_SMTP_USER=
POSTBOX_SMTP_PASSWORD=
POSTBOX_FROM_EMAIL=auth@labrica.pro
POSTBOX_FROM_NAME=LABRICA

# Login for admin.labrica.pro. Username is not an email. Keep the real password only in server environment.
ADMIN_LOGIN=sergiolabenzo
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Production process behind the reverse proxy for labrica.pro subdomains.
HOST=127.0.0.1
PORT=3001

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PROXY_URL=
